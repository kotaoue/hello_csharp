<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="hello_avalonia.AboutWindow"
    Title="About"
    Width="320"
    Height="220"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Hello C# Sample" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Avalonia で作るサンプルアプリです。" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="Counter / TODO / Theme / Settings / About" HorizontalAlignment="Center" TextAlignment="Center" />
        <Button Content="閉じる" Width="96" HorizontalAlignment="Center" Click="OnCloseClick" />
    </StackPanel>
</Window>
