<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:hello_avalonia"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="hello_avalonia.MainWindow"
    x:DataType="local:MainWindow"
    Title="Avalonia Todo"
    Width="560"
    Height="420">
    <DockPanel Margin="16">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_アプリ">
                <MenuItem Header="_設定" Click="OnOpenSettingsClick" />
                <MenuItem Header="_About" Click="OnOpenAboutClick" />
            </MenuItem>
        </Menu>

        <TabControl x:Name="RootTabs" Margin="0,12,0,0">
            <TabItem Header="1. カウンター">
                <StackPanel Margin="16" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Hello, Avalonia Counter!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />

                    <TextBlock x:Name="CountText"
                        Text="Count: 0"
                        FontSize="28"
                        HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="-1" Width="80" Click="OnDecrementClick" />
                        <Button Content="Reset" Width="100" Click="OnResetClick" />
                        <Button Content="+1" Width="80" Click="OnIncrementClick" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="2. TODO">
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock Text="Hello, Avalonia Todo!" FontSize="24" FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NewTodoTextBox" Width="360" PlaceholderText="新しいタスクを入力" />
                        <Button Content="追加" Width="80" Click="OnAddTodoClick" />
                    </StackPanel>

                    <CheckBox x:Name="ShowOnlyActiveCheckBox"
                        Content="未完了のみ表示"
                        IsChecked="False"
                        IsCheckedChanged="OnShowOnlyActiveChanged" />

                    <TextBlock x:Name="SummaryText"
                        Text="合計: 0件 (未完了: 0件)"
                        FontSize="14" />

                    <ListBox ItemsSource="{Binding VisibleTodos}" Height="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:TodoItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                    <CheckBox Grid.Column="0"
                                        IsChecked="{Binding IsDone}"
                                        VerticalAlignment="Center"
                                        IsCheckedChanged="OnTodoDoneChanged" />
                                    <TextBlock Grid.Column="1"
                                        Margin="8,0"
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                        Content="削除"
                                        Width="64"
                                        Click="OnDeleteTodoClick" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="3. テーマ">
                <StackPanel Margin="16" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Theme Switcher" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ThemeStatusText" Text="現在: System" FontSize="16" HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="Light" Width="90" Click="OnLightThemeClick" />
                        <Button Content="Dark" Width="90" Click="OnDarkThemeClick" />
                        <Button Content="System" Width="90" Click="OnSystemThemeClick" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="4. 検索リスト">
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock Text="Searchable List" FontSize="24" FontWeight="Bold" />

                    <TextBox x:Name="SearchTextBox"
                        Width="320"
                        PlaceholderText="キーワードを入力"
                        TextChanged="OnSearchTextChanged" />

                    <TextBlock x:Name="SearchResultText"
                        Text="0件表示中"
                        FontSize="14" />

                    <ListBox ItemsSource="{Binding VisibleSearchItems}" Height="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SearchItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.75" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                        Text="{Binding Category}"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
