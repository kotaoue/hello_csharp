<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="hello_avalonia.SettingsWindow"
    Title="設定"
    Width="360"
    Height="260"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="設定" FontSize="24" FontWeight="Bold" />

        <StackPanel Spacing="6">
            <TextBlock Text="テーマ" />
            <ComboBox x:Name="ThemeComboBox" Width="140" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="ウィンドウ幅" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="WindowWidthTextBox" Width="120" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="ウィンドウ高さ" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WindowHeightTextBox" Width="120" />
        </Grid>

        <TextBlock x:Name="StatusTextBlock" Foreground="Tomato" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="キャンセル" Click="OnCancelClick" />
            <Button Content="保存" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
